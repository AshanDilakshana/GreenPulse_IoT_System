[
    {
        "id": "tab1",
        "type": "tab",
        "label": "GreenPulse AI",
        "disabled": false,
        "info": ""
    },
    {
        "id": "ui_tab1",
        "type": "ui_tab",
        "name": "GreenPulse Dashboard",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "ui_group1",
        "type": "ui_group",
        "name": "Live Sensor Data",
        "tab": "ui_tab1",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_group2",
        "type": "ui_group",
        "name": "AI Historical Analysis",
        "tab": "ui_tab1",
        "order": 2,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "mqtt_in1",
        "type": "mqtt in",
        "z": "tab1",
        "name": "AWS IoT Sensors",
        "topic": "greenpulse/sensors",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker1",
        "x": 160,
        "y": 140,
        "wires": [
            [
                "func_temp",
                "func_hum",
                "func_moist",
                "func_co2",
                "func_light"
            ]
        ]
    },
    {
        "id": "func_temp",
        "type": "function",
        "z": "tab1",
        "name": "Extract Temp",
        "func": "msg.payload = msg.payload.temperature || 0;\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 60,
        "wires": [["gauge_temp"]]
    },
    {
        "id": "gauge_temp",
        "type": "ui_gauge",
        "z": "tab1",
        "name": "Temperature",
        "group": "ui_group1",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Temperature (°C)",
        "label": "°C",
        "format": "{{value}}",
        "min": 0,
        "max": "50",
        "colors": ["#00b500","#e6e600","#ca3838"],
        "x": 600,
        "y": 60,
        "wires": []
    },
    {
        "id": "func_hum",
        "type": "function",
        "z": "tab1",
        "name": "Extract Humidity",
        "func": "msg.payload = msg.payload.humidity || 0;\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 100,
        "wires": [["gauge_hum"]]
    },
    {
        "id": "gauge_hum",
        "type": "ui_gauge",
        "z": "tab1",
        "name": "Humidity",
        "group": "ui_group1",
        "order": 2,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Humidity (%)",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": ["#0080ff","#004080","#000040"],
        "x": 600,
        "y": 100,
        "wires": []
    },
    {
        "id": "func_moist",
        "type": "function",
        "z": "tab1",
        "name": "Extract Moisture",
        "func": "msg.payload = msg.payload.soilMoisture || 0;\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 140,
        "wires": [["gauge_moist"]]
    },
    {
        "id": "gauge_moist",
        "type": "ui_gauge",
        "z": "tab1",
        "name": "Soil Moisture",
        "group": "ui_group1",
        "order": 3,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Moisture (%)",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": ["#ca3838","#e6e600","#00b500"],
        "x": 600,
        "y": 140,
        "wires": []
    },
    {
        "id": "func_co2",
        "type": "function",
        "z": "tab1",
        "name": "Extract CO2",
        "func": "msg.payload = msg.payload.co2 || 0;\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 180,
        "wires": [["gauge_co2"]]
    },
    {
        "id": "gauge_co2",
        "type": "ui_gauge",
        "z": "tab1",
        "name": "CO2",
        "group": "ui_group1",
        "order": 4,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "CO2 (ppm)",
        "label": "ppm",
        "format": "{{value}}",
        "min": 400,
        "max": "2000",
        "colors": ["#00b500","#e6e600","#ca3838"],
        "x": 600,
        "y": 180,
        "wires": []
    },
    {
        "id": "func_light",
        "type": "function",
        "z": "tab1",
        "name": "Extract Light",
        "func": "msg.payload = msg.payload.light || 0;\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 220,
        "wires": [["gauge_light"]]
    },
    {
        "id": "gauge_light",
        "type": "ui_gauge",
        "z": "tab1",
        "name": "Light",
        "group": "ui_group1",
        "order": 5,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Light (Lux)",
        "label": "Lux",
        "format": "{{value}}",
        "min": 0,
        "max": "5000",
        "colors": ["#000000","#e6e600","#ffffff"],
        "x": 600,
        "y": 220,
        "wires": []
    },
    {
        "id": "inject_ai",
        "type": "inject",
        "z": "tab1",
        "name": "Trigger API (Every 5 mins)",
        "props": [],
        "repeat": "300",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "x": 160,
        "y": 340,
        "wires": [
            [
                "http_req"
            ]
        ]
    },
    {
        "id": "http_req",
        "type": "http request",
        "z": "tab1",
        "name": "Fetch AI Summary",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://localhost:3001/api/summary?hours=6",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 410,
        "y": 340,
        "wires": [
            [
                "ai_template"
            ]
        ]
    },
    {
        "id": "ai_template",
        "type": "ui_template",
        "z": "tab1",
        "group": "ui_group2",
        "name": "AI Report UI",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div style=\"padding: 10px; background-color: #2e2e2e; color: #ffffff; border-radius: 8px; font-family: sans-serif;\">\n    <h3 style=\"color: #4CAF50; margin-top: 0;\">AI Agent Report</h3>\n    <p><strong>Status:</strong> <span style=\"color: #ffeb3b;\">{{msg.payload.plant_status}}</span></p>\n    <p><strong>Summary:</strong> {{msg.payload.summary}}</p>\n    <p><strong>Trend:</strong> {{msg.payload.trend_analysis}}</p>\n    <p><strong>Prediction:</strong> {{msg.payload.prediction}}</p>\n    <h4 style=\"margin-bottom: 5px;\">Action Items:</h4>\n    <ul style=\"margin-top: 5px;\">\n        <li ng-repeat=\"item in msg.payload.action_items\">{{item}}</li>\n    </ul>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resizes": true,
        "templateScope": "local",
        "className": "",
        "x": 630,
        "y": 340,
        "wires": [
            []
        ]
    },
    {
        "id": "mqtt_broker1",
        "type": "mqtt-broker",
        "name": "AWS IoT Core",
        "broker": "YOUR_AWS_ENDPOINT.amazonaws.com",
        "port": "8883",
        "tls": "tls_config1",
        "clientid": "NodeRedDashboard",
        "autoConnect": true,
        "usetls": true,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "tls_config1",
        "type": "tls-config",
        "name": "AWS mTLS",
        "cert": "",
        "key": "",
        "ca": "",
        "certname": "",
        "keyname": "",
        "caname": "",
        "servername": "",
        "verifyservercert": true,
        "alpnprotocol": ""
    }
]
